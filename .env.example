# Copy to .env for local runs. Every value here is a placeholder.
# NEVER put a real credential in this repository.

PIPELINE_ENV=lab
AWS_REGION=eu-west-2

# Resource names must match terraform/locals.tf
JOBS_TABLE_NAME=cloud-pipeline-jobs
INPUT_BUCKET=cloud-pipeline-input
OUTPUT_BUCKET=cloud-pipeline-output
JOBS_QUEUE_URL=https://sqs.eu-west-2.amazonaws.com/000000000000/cloud-pipeline-jobs
DLQ_URL=https://sqs.eu-west-2.amazonaws.com/000000000000/cloud-pipeline-jobs-dlq

# CMP-SEC-004: these demonstrate unsafe secret handling via plain environment
# variables instead of Secrets Manager / SSM SecureString. Placeholders only.
REPORT_API_TOKEN=REPLACE_ME_PLACEHOLDER_NOT_A_REAL_SECRET
BILLING_SIGNING_KEY=REPLACE_ME_PLACEHOLDER_NOT_A_REAL_SECRET
DB_PASSWORD=REPLACE_ME_PLACEHOLDER_NOT_A_REAL_SECRET

# CMP-COST-014 / CMP-CODE-010: chatty logging and unbounded retries
LOG_LEVEL=DEBUG
LOG_FULL_PAYLOADS=true
MAX_RETRIES=0

# Set to 1 to opt in to AWS/LocalStack-backed functional tests.
PIPELINE_ENABLE_AWS_TESTS=0
# AWS_ENDPOINT_URL=http://localhost:4566

